FROM node:20-alpine AS builder
WORKDIR /app

ARG REACT_APP_USER_SERVICE_URL
ARG REACT_APP_PATIENT_SERVICE_URL
ARG REACT_APP_MESSAGE_SERVICE_URL
ARG REACT_APP_IMAGE_SERVICE_URL
ARG REACT_APP_SEARCH_SERVICE_URL
ARG REACT_APP_KEYCLOAK_URL
ARG REACT_APP_KEYCLOAK_REALM
ARG REACT_APP_KEYCLOAK_CLIENT_ID

ENV REACT_APP_USER_SERVICE_URL=$REACT_APP_USER_SERVICE_URL
ENV REACT_APP_PATIENT_SERVICE_URL=$REACT_APP_PATIENT_SERVICE_URL
ENV REACT_APP_MESSAGE_SERVICE_URL=$REACT_APP_MESSAGE_SERVICE_URL
ENV REACT_APP_IMAGE_SERVICE_URL=$REACT_APP_IMAGE_SERVICE_URL
ENV REACT_APP_SEARCH_SERVICE_URL=$REACT_APP_SEARCH_SERVICE_URL
ENV REACT_APP_KEYCLOAK_URL=$REACT_APP_KEYCLOAK_URL
ENV REACT_APP_KEYCLOAK_REALM=$REACT_APP_KEYCLOAK_REALM
ENV REACT_APP_KEYCLOAK_CLIENT_ID=$REACT_APP_KEYCLOAK_CLIENT_ID

COPY package.json .
RUN npm install

COPY public ./public
COPY src ./src

RUN npm run build

FROM node:20-alpine
WORKDIR /app

RUN npm install -g serve
COPY --from=builder /app/build ./build

EXPOSE 3000

CMD ["serve", "-s", "build", "-l", "3000"]
